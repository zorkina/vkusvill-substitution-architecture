@startuml 02-context
!include <C4/C4_Context>
!include style.puml

title C4 L1 · Контекст системы подбора замены
LAYOUT_TOP_DOWN()

Person(picker, "Сборщик", "Отмечает отсутствие товара.\nСогласует замену по телефону.")
Person(customer, "Покупатель", "Принимает или отклоняет\nпредложенный аналог.")

System(substitution, "Система подбора замены", "Подбирает аналог одной отсутствующей\nпозиции заказа. Фиксирует решение\nи возвращает результат сборщику.")

System_Ext(orders, "Система заказов", "Состав заказа и настройки замены.\nРезервирование и изменение суммы.")
System_Ext(catalog, "Каталог и остатки", "Характеристики товаров\nи доступность в точке сборки.")

Rel_R(picker, substitution, "Передает позицию и решение;\nполучает предложение и итог")
Rel_D(picker, customer, "Предлагает аналог и цену;\nполучает согласие или отказ", "Телефон")
Rel_R(substitution, orders, "Запрашивает состав и настройки;\nпередает согласованное изменение позиции")
Rel_R(substitution, catalog, "Запрашивает характеристики\nи доступные аналоги")

Lay_D(orders, catalog)
Lay_D(picker, customer)

legend bottom left
|= Обозначение |= Смысл |
| <back:#147D83>   </back> | Система в границах работы |
| <back:#E8EDF2>   </back> | Внешняя система компании |
| <back:#2F465B>   </back> | Участник процесса |
| Направленная стрелка | Инициатор взаимодействия; ответ указан в подписи |
| Границы и связи | Допущения архитектурной реконструкции |
endlegend
@enduml
